# systemd-Dienst für Discord 2.0 (siehe ANLEITUNG.md, Teil 2c).
# Kopieren nach /etc/systemd/system/discord2.service
[Unit]
Description=Discord 2.0
After=network-online.target
Wants=network-online.target

[Service]
User=discord2
WorkingDirectory=/opt/discord-2.0
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
