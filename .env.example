# Port des Webservers
PORT=3000

# Öffentliche Adresse von Discord 2.0 (für "Mit Discord anmelden" und den /discord2-Befehl)
PUBLIC_URL=http://localhost:3000

# Pfad zur SQLite-Datenbank
DATABASE_FILE=data/discord2.db

# Token deines Discord-Bots (https://discord.com/developers/applications → Bot).
# Ohne Token läuft Discord 2.0 ohne Verbindung zu Discord.
DISCORD_BOT_TOKEN=

# Für "Mit Discord anmelden" (Developer Portal → OAuth2). Redirect-URL dort eintragen:
#   <PUBLIC_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: Avatar-URL für Discord-2.0-Nutzer ohne Discord-Konto, wenn sie auf Discord schreiben.
# Platzhalter: {username}, {id}. Beispiel:
# AVATAR_URL_TEMPLATE=https://api.dicebear.com/9.x/initials/png?seed={username}
AVATAR_URL_TEMPLATE=

# Optional: STUN/TURN-Server für Anrufe als JSON. Ohne TURN-Server klappen Anrufe
# hinter manchen Firmen-/Mobilfunk-Netzen nicht. Beispiel:
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
ICE_SERVERS=
