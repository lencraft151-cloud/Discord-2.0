# Port des Webservers
PORT=3000

# Pfad zur SQLite-Datenbank
DATABASE_FILE=data/discord2.db

# Token deines Discord-Bots (https://discord.com/developers/applications).
# Ohne Token läuft Discord 2.0 ohne Verbindung zu Discord.
DISCORD_BOT_TOKEN=

# Optional: Avatar-URL für Discord-2.0-Nutzer, wenn sie auf Discord schreiben.
# Platzhalter: {username}, {id}. Beispiel:
# AVATAR_URL_TEMPLATE=https://api.dicebear.com/9.x/initials/png?seed={username}
AVATAR_URL_TEMPLATE=
